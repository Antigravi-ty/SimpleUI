{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "block": "panel",
  "prefix": "ui-panel",
  "description": "Apple HIG 3-stage container panel with header, dynamic content slot, and accessible description footer",
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "defaultSize": "md",
  "props": {
    "title": {
      "type": "string",
      "default": "Title"
    },
    "description": {
      "type": "string",
      "default": "Relative description"
    }
  },
  "events": [
    "panel:back"
  ],
  "modifiers": [
    "neutral",
    "bordered",
    "elevated"
  ],
  "stateMappings": {},
  "elements": [
    {
      "name": "standard",
      "label": "Standard 3-Stage",
      "selector": "",
      "defaultText": "Title",
      "template": "<div class=\"{classes}\" role=\"region\" aria-label=\"Widget Panel\"><header class=\"ui-panel__header\"><div class=\"ui-panel__header-left\"><button type=\"button\" class=\"ui-panel__back-btn\" aria-label=\"Go Back\" title=\"Back (ESC)\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"15 18 9 12 15 6\"/></svg></button><h3 class=\"ui-panel__title\">{slot:default}</h3></div><span class=\"ui-badge ui-badge--neutral ui-badge--sm\">Active</span></header><div class=\"ui-panel__content\"><div class=\"ui-panel__content-slot\">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</div></div><footer class=\"ui-panel__footer\"><div class=\"ui-panel__desc\" role=\"status\" aria-live=\"polite\">Relative description</div><span class=\"ui-panel__hint\">ESC</span></footer></div>"
    },
    {
      "name": "footer-back",
      "label": "With Bottom Back",
      "selector": "--with-footer-back",
      "defaultText": "Title",
      "template": "<div class=\"{classes}\" role=\"region\" aria-label=\"Widget Panel\"><header class=\"ui-panel__header\"><div class=\"ui-panel__header-left\"><button type=\"button\" class=\"ui-panel__back-btn\" aria-label=\"Go Back\" title=\"Back (ESC)\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"15 18 9 12 15 6\"/></svg></button><h3 class=\"ui-panel__title\">{slot:default}</h3></div></header><div class=\"ui-panel__content\"><div class=\"ui-panel__content-slot\">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</div></div><footer class=\"ui-panel__footer\"><div class=\"ui-panel__desc\" role=\"status\" aria-live=\"polite\">Relative description</div><button type=\"button\" class=\"ui-btn ui-btn--sm ui-btn--neutral ui-panel__footer-back\" aria-label=\"Back\">Back</button></footer></div>"
    }
  ]
}