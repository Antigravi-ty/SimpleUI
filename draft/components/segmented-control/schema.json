{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "draft-ui-segmented-control",
  "block": "segmented-control",
  "name": "segmented-control",
  "title": "Segmented Control",
  "prefix": "draft-ui-segmented-control",
  "status": "draft",
  "archetype": "selection",
  "description": "Apple HIG segmented control for switching views or modes (Draft Incubator)",
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "defaultSize": "md",
  "props": {
    "disabled": {
      "type": "boolean",
      "default": false
    }
  },
  "events": [
    "change"
  ],
  "modifiers": [
    "neutral",
    "primary",
    "disabled"
  ],
  "stateMappings": {
    "disabled": {
      "attributes": "disabled",
      "aria-disabled": "true"
    }
  },
  "elements": [
    {
      "name": "standard",
      "label": "Text Labels",
      "selector": "",
      "template": "<div class=\"{classes}\" role=\"tablist\"><button type=\"button\" role=\"tab\" class=\"ui-segmented-control__item ui-segmented-control__item--active\" aria-selected=\"true\" data-value=\"option-1\" {attributes}>Option 1</button><button type=\"button\" role=\"tab\" class=\"ui-segmented-control__item\" aria-selected=\"false\" data-value=\"option-2\" {attributes}>Option 2</button><button type=\"button\" role=\"tab\" class=\"ui-segmented-control__item\" aria-selected=\"false\" data-value=\"option-3\" {attributes}>Option 3</button></div>"
    },
    {
      "name": "leading-icon",
      "label": "Leading Icon",
      "selector": "--leading-icon",
      "template": "<div class=\"{classes}\" role=\"tablist\"><button type=\"button\" role=\"tab\" class=\"ui-segmented-control__item ui-segmented-control__item--active\" aria-selected=\"true\" data-value=\"option-1\" {attributes}><svg class=\"ui-segmented-control__icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg><span>Option 1</span></button><button type=\"button\" role=\"tab\" class=\"ui-segmented-control__item\" aria-selected=\"false\" data-value=\"option-2\" {attributes}><svg class=\"ui-segmented-control__icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg><span>Option 2</span></button></div>"
    },
    {
      "name": "trailing-icon",
      "label": "Trailing Icon",
      "selector": "--trailing-icon",
      "template": "<div class=\"{classes}\" role=\"tablist\"><button type=\"button\" role=\"tab\" class=\"ui-segmented-control__item ui-segmented-control__item--active\" aria-selected=\"true\" data-value=\"option-1\" {attributes}><span>Option 1</span><svg class=\"ui-segmented-control__icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg></button><button type=\"button\" role=\"tab\" class=\"ui-segmented-control__item\" aria-selected=\"false\" data-value=\"option-2\" {attributes}><span>Option 2</span><svg class=\"ui-segmented-control__icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg></button></div>"
    },
    {
      "name": "icon-only",
      "label": "Icon Only",
      "selector": "--icon-only",
      "template": "<div class=\"{classes}\" role=\"tablist\"><button type=\"button\" role=\"tab\" class=\"ui-segmented-control__item ui-segmented-control__item--active\" aria-selected=\"true\" data-value=\"option-1\" aria-label=\"Option 1\" {attributes}><svg class=\"ui-segmented-control__icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"7\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"7\" x=\"14\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"7\" x=\"14\" y=\"14\" rx=\"1\"/><rect width=\"7\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\"/></svg></button><button type=\"button\" role=\"tab\" class=\"ui-segmented-control__item\" aria-selected=\"false\" data-value=\"option-2\" aria-label=\"Option 2\" {attributes}><svg class=\"ui-segmented-control__icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"8\" x2=\"21\" y1=\"6\" y2=\"6\"/><line x1=\"8\" x2=\"21\" y1=\"12\" y2=\"12\"/><line x1=\"8\" x2=\"21\" y1=\"18\" y2=\"18\"/><line x1=\"3\" x2=\"3.01\" y1=\"6\" y2=\"6\"/><line x1=\"3\" x2=\"3.01\" y1=\"12\" y2=\"12\"/><line x1=\"3\" x2=\"3.01\" y1=\"18\" y2=\"18\"/></svg></button></div>"
    }
  ],
  "io": {
    "model": {
      "selector": ".ui-segmented-control__item--active",
      "attr": "data-value",
      "type": "string"
    },
    "signals": {
      "change": "change"
    }
  },
  "collection": {
    "itemsKey": "items",
    "target": ":root",
    "itemTag": "button",
    "itemClass": "{prefix}__item ui-segmented-control__item",
    "activeClass": "{prefix}__item--active ui-segmented-control__item--active",
    "role": "tab"
  },
  "variants": {
    "content": {
      "label": "Content",
      "default": "text",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "leading-icon",
          "label": "Leading Icon"
        },
        {
          "value": "trailing-icon",
          "label": "Trailing Icon"
        },
        {
          "value": "icon-only",
          "label": "Icon Only"
        }
      ]
    }
  }
}
